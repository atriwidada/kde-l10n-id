#: src/effects/backgroundcontrast/metadata.json
msgctxt "Description"
msgid "Improve contrast and readability behind semi-transparent windows"
msgstr "Memperbaiki kontras dan keterbacaan belakang jendela semi transparan"

#: src/effects/blendchanges/metadata.json
msgctxt "Description"
msgid "Animates system style changes"
msgstr "Menganimasikan perubahan gaya sistem"

#: src/effects/blur/metadata.json
msgctxt "Description"
msgid "Blurs the background behind semi-transparent windows"
msgstr "Memburamkan belakang latar-belakang jendela semi transparan"

#: src/effects/colorpicker/metadata.json
msgctxt "Description"
msgid "Supports picking a color"
msgstr "Mendukung penukilan warna"

#: src/effects/desktopgrid/metadata.json
msgctxt "Description"
msgid "Zoom out so all desktops are displayed side-by-side in a grid"
msgstr ""
"Zoom keluar sehingga semua desktop ditampilkan sisi demi sisi di dalam kisi"

#: src/effects/dialogparent/package/metadata.json
msgctxt "Description"
msgid "Darkens the parent window of the currently active dialog"
msgstr "Memetangkan jendela induk dari dialog yang saat ini aktif"

#: src/effects/diminactive/metadata.json
msgctxt "Description"
msgid "Darken inactive windows"
msgstr "Menggelapkan jendela yang tidak aktif"

#: src/effects/dimscreen/package/metadata.json
msgctxt "Description"
msgid "Darkens the entire screen when requesting root privileges"
msgstr "Memetangkan seluruh layar ketika meminta hak akses root"

#: src/effects/eyeonscreen/package/metadata.json
msgctxt "Description"
msgid "Suck windows into the desktop"
msgstr "Sedot jendela ke dalam desktop"

#: src/effects/fadedesktop/package/metadata.json
msgctxt "Description"
msgid "Fade between virtual desktops when switching between them"
msgstr "Lesapkan antar desktop virtual ketika diantara mereka beralih"

#: src/effects/fade/package/metadata.json
msgctxt "Description"
msgid "Make windows smoothly fade in and out when they are shown or hidden"
msgstr ""
"Buat jendela secara halus melesap ketika ia ditampilkan atau disembunyikan"

#: src/effects/fadingpopups/package/metadata.json
msgctxt "Description"
msgid "Make popups smoothly fade in and out when they are shown or hidden"
msgstr ""
"Buat sembulan secara halus melesap ketika ia ditampilkan atau disembunyikan"

#: src/effects/fallapart/metadata.json
msgctxt "Description"
msgid "Closed windows fall into pieces"
msgstr "Jendela ditutup pecah berpuing-puing"

#: src/effects/frozenapp/package/metadata.json
msgctxt "Description"
msgid "Desaturate windows of unresponsive (frozen) applications"
msgstr "Desaturasikan jendela pada aplikasi yang tidak responsif (beku)"

#: src/effects/fullscreen/package/metadata.json
msgctxt "Description"
msgid "Animation for a window going to and leaving full screen mode"
msgstr "Animasi untuk jendela yang menuju dan meninggalkan mode layar penuh"

#: src/effects/glide/metadata.json
msgctxt "Description"
msgid "Glide windows as they appear or disappear"
msgstr "Glide Jendela sebagaimana ia muncul atau menghilang"

