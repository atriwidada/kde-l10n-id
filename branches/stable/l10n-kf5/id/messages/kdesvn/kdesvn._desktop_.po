#: src/kdesvnd/kdesvnd.desktop:3
msgctxt "Name"
msgid "kdesvnd subversion module"
msgstr "modul subversion kdesvnd"

#: src/kdesvnd/kdesvnd.desktop:40
msgctxt "Comment"
msgid "Gives various Subversion actions to file managers and other software"
msgstr ""
"Memberikan banyak tindakan Subversion ke pengelola file dan perangkat lunak "
"lainnya"

#: src/kdesvnd/kdesvn_subversion.desktop:4
msgctxt "X-KDE-Submenu"
msgid "Subversion (kdesvn)"
msgstr "Subversion (kdesvn)"

#: src/kdesvnd/kdesvn_subversion.desktop:44
msgctxt "Name"
msgid "Subversion log (last 100)"
msgstr "Catatan Subversion (100 terakhir)"

#: src/kdesvnd/kdesvn_subversion.desktop:82
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:46
msgctxt "Comment"
msgid "Displays the Subversion log"
msgstr "Menampilkan catatan Subversion"

#: src/kdesvnd/kdesvn_subversion.desktop:120
msgctxt "Name"
msgid "Detailed Subversion info"
msgstr "Detail info Subversion"

#: src/kdesvnd/kdesvn_subversion.desktop:160
msgctxt "Name"
msgid "Add to Repository"
msgstr "Tambahkan ke Repositori"

#: src/kdesvnd/kdesvn_subversion.desktop:202
msgctxt "Name"
msgid "Check for unversioned items"
msgstr "Periksa item yang belum diversikan"

#: src/kdesvnd/kdesvn_subversion.desktop:241
msgctxt "Name"
msgid "Delete From Repository"
msgstr "Hapus Dari Repositori"

#: src/kdesvnd/kdesvn_subversion.desktop:281
msgctxt "Name"
msgid "Revert Local Changes"
msgstr "Kembalikan Perubahan Lokal"

#: src/kdesvnd/kdesvn_subversion.desktop:319
msgctxt "Comment"
msgid "Remove any changes made locally. Warning - this cannot be undone."
msgstr ""
"Menghapus perubahan apa pun yang dibuat secara lokal. Peringatan - ini tidak "
"dapat dipulihkan."

#: src/kdesvnd/kdesvn_subversion.desktop:357
msgctxt "Name"
msgid "Rename..."
msgstr "Ubah nama..."

#: src/kdesvnd/kdesvn_subversion.desktop:396
msgctxt "Comment"
msgid ""
"Rename a file locally and in the repository.  Use this rather than adding "
"and deleting to rename a file."
msgstr ""
"Ubah nama secara lokal dan di repositori juga.  Gunakan ini daripada "
"menambahkan dan menghapus untuk menamai ulang sebuah file."

#: src/kdesvnd/kdesvn_subversion.desktop:434
msgctxt "Name"
msgid "Import Repository"
msgstr "Impor Repositori"

#: src/kdesvnd/kdesvn_subversion.desktop:472
msgctxt "Comment"
msgid ""
"Put folder into an existing repository to put it under revision control."
msgstr ""
"Letakkan folder ke sebuah repositori yang sudah ada untuk meletakkannya di "
"bawah pengontrolan revisi."

#: src/kdesvnd/kdesvn_subversion.desktop:510
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:84
msgctxt "Name"
msgid "Checkout From Repository..."
msgstr "Dapatkan Dari Repositori..."

#: src/kdesvnd/kdesvn_subversion.desktop:548
#: src/kdesvnd/kdesvn_subversion.desktop:1119
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:122
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:348
msgctxt "Comment"
msgid "Checkout out files from an existing repository into this folder."
msgstr "Mendapatkan file dari sebuah repositori yang sudah ada ke folder ini."

#: src/kdesvnd/kdesvn_subversion.desktop:586
msgctxt "Name"
msgid "Switch..."
msgstr "Ubah..."

#: src/kdesvnd/kdesvn_subversion.desktop:623
msgctxt "Comment"
msgid "Switch given working copy to another branch"
msgstr "Ubah salinan yang bekerja saat ini ke ranting lain"

#: src/kdesvnd/kdesvn_subversion.desktop:662
msgctxt "Name"
msgid "Merge..."
msgstr "Gabungkan..."

#: src/kdesvnd/kdesvn_subversion.desktop:700
msgctxt "Comment"
msgid "Merge changes between this and another branch"
msgstr "Gabungkan perubahan antara ini dan ranting lain"

#: src/kdesvnd/kdesvn_subversion.desktop:739
msgctxt "Name"
msgid "Blame..."
msgstr "Lihat Perubahan..."

#: src/kdesvnd/kdesvn_subversion.desktop:776
msgctxt "Comment"
msgid "See who wrote each line of the file and in what revision"
msgstr "Lihat siapa tulis baris apa dari file dan di revisi apa"

#: src/kdesvnd/kdesvn_subversion.desktop:815
msgctxt "Name"
msgid "Create Patch..."
msgstr "Buat Tambalan..."

#: src/kdesvnd/kdesvn_subversion.desktop:855
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:160
msgctxt "Name"
msgid "Export..."
msgstr "Ekspor..."

#: src/kdesvnd/kdesvn_subversion.desktop:894
#: src/kdesvnd/kdesvn_subversion.desktop:1194
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:199
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:423
msgctxt "Comment"
msgid "Checkout out an unversioned copy of a tree from a repository"
msgstr ""
"Dapatkan sebuah salinan tanpa revisi versi dari sebuah pohon dari sebuah "
"repositori"

#: src/kdesvnd/kdesvn_subversion.desktop:932
msgctxt "Name"
msgid "Diff (local)"
msgstr "Perbedaan (lokal)"

#: src/kdesvnd/kdesvn_subversion.desktop:970
msgctxt "Comment"
msgid "Show local changes since last update"
msgstr "Tampilkan perubahan lokal setelah pembaruan terakhir"

#: src/kdesvnd/kdesvn_subversion.desktop:1008
msgctxt "Name"
msgid "KDESvn Update"
msgstr "Pembaruan KDESvn"

#: src/kdesvnd/kdesvn_subversion.desktop:1046
msgctxt "Name"
msgid "KDESvn Commit"
msgstr "Serahan KDESvn"

#: src/kdesvnd/kdesvn_subversion.desktop:1083
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:312
msgctxt "Name"
msgid "Checkout from a repository..."
msgstr "Dapatkan dari sebuah repositori..."

#: src/kdesvnd/kdesvn_subversion.desktop:1157
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:386
msgctxt "Name"
msgid "Export from a Subversion repository..."
msgstr "Ekspor dari sebuah repositori Subversion..."

#: src/kdesvnd/kdesvn_subversion.desktop:1232
msgctxt "Name"
msgid "Display revision tree"
msgstr "Tampilkan pohon revisi"

#: src/kdesvnd/kdesvn_subversion.desktop:1269
msgctxt "Comment"
msgid "Show complete revision tree"
msgstr "Tampilkan pohon revisi lengkap"

#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:9
msgctxt "Name"
msgid "kdesvn log (last 100)"
msgstr "Catatan kdesvn (100 terakhir)"

#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:237
msgctxt "Name"
msgid "Update (Kdesvn)"
msgstr "Perbarui (Kdesvn)"

#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:275
msgctxt "Name"
msgid "Commit (Kdesvn)"
msgstr "Serahan (Kdesvn)"

#: src/kdesvn.notifyrc:3
msgctxt "Comment"
msgid "Kdesvn notification"
msgstr "Notifikasi Kdesvn"

#: src/kdesvn.notifyrc:41
msgctxt "Name"
msgid "Kdesvn KIO Notification"
msgstr "Notifikasi KIO Kdesvn"

#: src/kdesvn.notifyrc:80
msgctxt "Name"
msgid "Kdesvn task notification"
msgstr "Notifikasi tugas Kdesvn"

#: src/kdesvnpart.desktop:2
msgctxt "Name"
msgid "kdesvnpart"
msgstr "kdesvnpart"

#: src/kdesvnpart.desktop:39
msgctxt "GenericName"
msgid "SVN Client"
msgstr "Klien SVN"

#: src/kdesvnpart.desktop:80 src/org.kde.kdesvn.desktop:78
msgctxt "Comment"
msgid "A Subversion client by KDE"
msgstr "Sebuah klien Subversion oleh KDE"

